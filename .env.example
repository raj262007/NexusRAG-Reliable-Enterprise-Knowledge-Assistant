# ==============================================================================
# NexusRAG Configuration
# ==============================================================================

# Application Environment
PROJECT_NAME="NexusRAG"
ENVIRONMENT="development"

# Storage Directories (relative to project root or absolute paths)
UPLOAD_DIR="data/uploads"
PROCESSED_DIR="data/processed"
QDRANT_STORAGE_PATH="data/qdrant"

# Vector Database
COLLECTION_NAME="nexusrag"

# Embedding Engine (Runs on CPU by default for stability on 16GB RAM)
EMBEDDING_MODEL="sentence-transformers/all-MiniLM-L6-v2"
EMBEDDING_DEVICE="cpu"

# Chunking Parameters (Character counts)
CHUNK_SIZE=500
CHUNK_OVERLAP=100

# File Upload Security Limits
MAX_FILE_SIZE_MB=25

# Local Ollama LLM Configuration
# Recommended models for 16GB RAM / 4GB VRAM: "qwen2.5:3b", "llama3.2:3b", or "mistral:7b"
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="qwen2.5:3b"
OLLAMA_TIMEOUT_SECONDS=60.0

# Retrieval Parameters
TOP_K_RETRIEVAL=5
RRF_K=60
